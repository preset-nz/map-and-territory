{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Map & Territory",
  "version": "../package.json",
  "identifier": "nz.preset.map-and-territory",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1480",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Map & Territory",
        "width": 900,
        "height": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["campaign"],
        "name": "Map & Territory Campaign",
        "role": "Editor",
        "rank": "Owner",
        "contentTypes": ["nz.preset.map-and-territory.campaign"],
        "exportedType": {
          "identifier": "nz.preset.map-and-territory.campaign",
          "conformsTo": ["public.data", "public.content"]
        }
      }
    ]
  }
}
